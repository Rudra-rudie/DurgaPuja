model Section {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeritagePillar {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  icon      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleDay {
  id        String         @id @default(cuid())
  dayKey    String         @unique
  dayName   String
  dateLabel String
  order     Int            @default(0)
  items     ScheduleItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ScheduleItem {
  id          String      @id @default(cuid())
  dayId       String
  day         ScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  tag         String      @default("DAWN")
  time        String
  title       String?
  description String
  priest      String?
  hasReminder Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  url       String
  altText   String?
  isWide    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BhogItem {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   @default("rice_bowl")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CulturalEvent {
  id        String   @id @default(cuid())
  month     String   @default("OCT")
  day       String
  title     String
  detail    String
  icon      String   @default("theater_comedy")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransitOption {
  id        String   @id @default(cuid())
  title     String
  detail    String
  icon      String   @default("subway")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DaanTier {
  id        String   @id @default(cuid())
  amount    Int
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RSVP {
  id         String   @id @default(cuid())
  tokenCode  String   @unique
  name       String
  phone      String
  members    Int      @default(2)
  ritual     String
  notes      String?
  createdAt  DateTime @default(now())
}

model GuestInvite {
  id              String   @id @default(cuid())
  slug            String   @unique
  guestName       String
  personalMessage String?
  viewsCount      Int      @default(0)
  isFamily        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
